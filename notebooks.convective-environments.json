b[38;5;28;01mas\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21;01mpd\u001b[39;00m\n\n\u001b[0;31mModuleNotFoundError\u001b[0m: No module named 'ipywidgets'","ename":"ModuleNotFoundError","evalue":"No module named 'ipywidgets'"},"key":"sH93YccZNW"}],"key":"qmjldIuyeB"}],"identifier":"b7e19916-2257-4043-aadf-f4573950d447","html_id":"b7e19916-2257-4043-aadf-f4573950d447","key":"bHcu1HgmwQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Remote data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QnCAe770jF"}],"identifier":"remote-data","label":"Remote data","html_id":"remote-data","implicit":true,"key":"mcRd1k8jAp"}],"identifier":"65b19985-b91c-4aa2-8ff0-b7f39df031b4","html_id":"65b19985-b91c-4aa2-8ff0-b7f39df031b4","key":"fi7dCmJnui"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"url_thredds = \"https://thredds.hydroshare.org/thredds/catalog/hydroshare/resources/6be754bf29cb488b815810c35f3f0ac9/data/contents/nyc_out/catalog.html\"\n\ninidt = datetime(2021, 9, 1, 13)\nenddt = datetime(2021, 9, 2, 12)\n\nlist_files = scvtmesh.get_thredds_list(\n    url_thredds,\n    date_start=inidt,\n    date_end=enddt\n)\n\nlist_files[:3]","key":"UjIr0Kbmqg"},{"type":"outputs","id":"DQyvwfyPBLHm_ex1dQ1jd","children":[],"key":"LlZcK8ZcG3"}],"identifier":"efee8e96-a7b7-4406-8152-1865bdbb9d34","html_id":"efee8e96-a7b7-4406-8152-1865bdbb9d34","key":"fLJ7N4VwjT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Initalizing MPAS-Viewer\ngrid_file = \"http://thredds.hydroshare.org/thredds/dodsC/hydroshare/resources/6be754bf29cb488b815810c35f3f0ac9/data/contents/nyc_static/nyc.static.nc\"\n\nmpasd = scvtmesh(\n    grid_file=grid_file,\n    diag_list=list_files\n)","key":"AMWErMLq3x"},{"type":"outputs","id":"BEd3hilRZiEpxVvp2hOgE","children":[],"key":"ml7bfabp9x"}],"identifier":"2324af77-a23d-463a-8c05-d964ff1c4dc0","html_id":"2324af77-a23d-463a-8c05-d964ff1c4dc0","key":"QU55LqQicS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Loading in necessary variables\nload_vars = [\"rainnc\", \"rainc\", \"t2m\", \"olrtoa\", \"refl10cm_max\"]\n\nmpasd.dataset(load_variables=load_vars)\nmpasd.rain_rate()\n\ndta = mpasd.load()","key":"zPZwqOlanL"},{"type":"outputs","id":"Ju7t6NbMZZFschOSx_rii","children":[],"key":"UpgI9NTf9P"}],"identifier":"78497c37-455c-4bed-8534-821c37328eda","html_id":"78497c37-455c-4bed-8534-821c37328eda","key":"XGv9neuCQJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# double checking times and dates\nprint(dta)\nprint(dta[\"time\"].values)","key":"N8WOJ62mTC"},{"type":"outputs","id":"DdYMEq6cPRUzKMgOt78LU","children":[],"key":"XKPBKTX53m"}],"identifier":"5b29d286-6838-415e-8d18-b1f6c5a001e2","html_id":"5b29d286-6838-415e-8d18-b1f6c5a001e2","key":"tFGhnNZhDA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for i, t in enumerate(dta[\"time\"].values):\n    max_rain = dta[\"rain_rate\"].isel(time=i).max().compute().values\n    print(i, t, max_rain)","key":"foxoBWg8xQ"},{"type":"outputs","id":"uWxtWppoj_NXP_5JbZBBj","children":[],"key":"F36QDW4dZc"}],"identifier":"a6597689-bd5d-4db5-bc91-226f828e034e","html_id":"a6597689-bd5d-4db5-bc91-226f828e034e","key":"pgqRo8eGh5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Rain rate\nsubd = mpasd.get_subset(\n    dta,\n    lon=(-75, -71),\n    lat=(39, 42.5)\n)","key":"ZnODBkI7A2"},{"type":"outputs","id":"r5EzX8ukZWBxiz7X8t4R_","children":[],"key":"WtUBAk3lQe"}],"identifier":"a7c637f9-8a0c-40c2-8a90-1fe2684e266a","html_id":"a7c637f9-8a0c-40c2-8a90-1fe2684e266a","key":"JLJHKlOc4w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from earthcmap import escmap\n\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\nmpasd.show(\n    dta,\n    var_name=\"rain_rate\",\n    time_index=8,\n    figsize=(8,8),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"Rain Rate at 2100 UTC\",\n    pad=30,\n    x=0.57 #shifts the title to the center of the plot\n)","key":"TLwytCrdtd"},{"type":"outputs","id":"hXBjE6BnvTUT0caeZu4OE","children":[],"key":"B93CIRDf2B"}],"identifier":"54aac3df-69ac-4e46-a336-76afd2732abc","html_id":"54aac3df-69ac-4e46-a336-76afd2732abc","key":"HDJnv7iJNz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Rain rate is used to identify the location and intensity of the heaviest precipitation associated with the remnants of Hurricane Ida.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a365RA4Ogz"}],"key":"GQF2rW5qVg"}],"identifier":"04e3398c-29c6-48c5-8e19-6594dbb2fc93","html_id":"04e3398c-29c6-48c5-8e19-6594dbb2fc93","key":"XBp6Z6T9HY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reflectivity","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x7vCW6THjY"}],"identifier":"reflectivity","label":"Reflectivity","html_id":"reflectivity","implicit":true,"key":"QWnMQEPs6z"}],"identifier":"1dc134f9-ff3f-4421-a092-e44c730b1f5e","html_id":"1dc134f9-ff3f-4421-a092-e44c730b1f5e","key":"JiREyo5ygG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cmap, norm = escmap(\"mrms_cref\")\n\nmpasd.show(\n    dta,\n    var_name=\"refl10cm_max\",\n    time_index=8,\n    figsize=(8,8),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"Maximum 10-cm Reflectivity at 2100 UTC\",\n    pad=30,\n    x=0.57\n)","key":"wGY1nUnCJf"},{"type":"outputs","id":"Nh2WZAd56oxPKFvE153Dj","children":[],"key":"tg332zMDV1"}],"identifier":"b9ca188c-218d-4718-ac83-c400378aa6aa","html_id":"b9ca188c-218d-4718-ac83-c400378aa6aa","key":"prqXVCWzOQ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulated maximum reflectivity highlights regions of organized precipitation and convective structures during the event.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vGGpA7I3Rl"}],"key":"ELp3cE0G4U"}],"identifier":"4f7bf8d4-9f8f-45a3-87fe-fec0a4292b23","html_id":"4f7bf8d4-9f8f-45a3-87fe-fec0a4292b23","key":"yN20kxo7UF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Outgoing Longwave Radiation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TspTiRJJQ5"}],"identifier":"outgoing-longwave-radiation","label":"Outgoing Longwave Radiation","html_id":"outgoing-longwave-radiation","implicit":true,"key":"NDxFtHvZ8L"}],"identifier":"71e9e0c8-2dd9-4bda-a608-24fbcc977a49","html_id":"71e9e0c8-2dd9-4bda-a608-24fbcc977a49","key":"obbvy9K3WD"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# importing for colormap usage\nimport matplotlib.colors as colors\ncmap = plt.get_cmap(\"gray_r\")\nnorm = colors.Normalize(vmin=100, vmax=320)\\\n\nmpasd.show(\n    dta,\n    var_name=\"olrtoa\",\n    time_index=8,\n    figsize=(8, 5),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"OLR at 2100 UTC\",\n    pad=30,\n    x=0.73\n)","key":"u0Zx2wFC0H"},{"type":"outputs","id":"TZp6L2dyINUQm3PVI467x","children":[],"key":"v0czc6GeSX"}],"identifier":"e6bfd949-065d-452f-a63b-0a82703b29bd","html_id":"e6bfd949-065d-452f-a63b-0a82703b29bd","key":"bSteA5194q"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Outgoing longwave radiation (OLR) provides information about cloud-top characteristics, with lower values generally associated with deeper convection and colder cloud tops.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LdVO63Bxkt"}],"key":"MgmMlwPQMg"}],"identifier":"3fa8b968-9436-4886-a447-5f7c4f0a39e2","html_id":"3fa8b968-9436-4886-a447-5f7c4f0a39e2","key":"dxU7fViurk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Evolution of Rainfall During Hurricane Ida","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZgLuUmnXjw"}],"identifier":"evolution-of-rainfall-during-hurricane-ida","label":"Evolution of Rainfall During Hurricane Ida","html_id":"evolution-of-rainfall-during-hurricane-ida","implicit":true,"key":"mVM1LWPXUM"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"To better understand the temporal evolution of the event, we create an animation of simulated rain rate from 13 UTC 1 September through 12 UTC 2 September 2021. This animation highlights the development, intensification, and movement of precipitation associated with the remnants of Hurricane Ida.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GxjwHbzPwj"}],"key":"zBB600EHaH"}],"identifier":"23af8f56-cd7a-4425-9d5e-2762f204eb9d","html_id":"23af8f56-cd7a-4425-9d5e-2762f204eb9d","key":"bN6f3XWT0Y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Install Imageio to make a gif","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R3t4y52FGg"}],"identifier":"install-imageio-to-make-a-gif","label":"Install Imageio to make a gif","html_id":"install-imageio-to-make-a-gif","implicit":true,"key":"itDlKL6rn2"}],"identifier":"a8a23965-26fc-4961-8327-045a44f923ab","html_id":"a8a23965-26fc-4961-8327-045a44f923ab","key":"iTALHgizTP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"!pip install imageio","key":"ReqSuogqaF"},{"type":"outputs","id":"MgkmxKlaCO9hE_nEYvwgr","children":[],"key":"uHanjvS4dY"}],"identifier":"c7e23b8d-56ad-45b9-bdf0-2fc53d5f8f28","html_id":"c7e23b8d-56ad-45b9-bdf0-2fc53d5f8f28","key":"JUNzzMmnZZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plotting 3 time frames before peak, during peak and after peak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k5KZrPDUb2"}],"identifier":"plotting-3-time-frames-before-peak-during-peak-and-after-peak","label":"Plotting 3 time frames before peak, during peak and after peak","html_id":"plotting-3-time-frames-before-peak-during-peak-and-after-peak","implicit":true,"key":"dZ9gre4NNi"}],"identifier":"c309e50e-94bf-4818-b117-346dd3252001","html_id":"c309e50e-94bf-4818-b117-346dd3252001","key":"KC3mvEoH4b"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS Color QPE colormaps\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\n# Select representative times showing the evolution of rainfall: before peak intensity, during peak intensity, and after the event begins to weaken.\ntimes = [6, 8, 15]\n\nfor idx in times:\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5,5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n     # Add timestamp to each frame\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    ax = plt.gca()\n    plt.title(\n        f\"\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.savefig(\n        f\"rain_rate_{idx:02d}.png\",\n        dpi=150,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()","key":"dGPxUb6ZET"},{"type":"outputs","id":"SXxuccV3VLd4nT9ae6Znd","children":[],"key":"N9tFswqMHq"}],"identifier":"58053a3f-6ba8-4717-bbe3-317db3df92ff","html_id":"58053a3f-6ba8-4717-bbe3-317db3df92ff","key":"QoXgiSPm6Y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS map colors\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\ntimes = [6, 8, 15]\n\nfor idx in times:\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5, 5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    ax = plt.gca()\n    ax.set_title(\n        f\"Rain Rate\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.show()","key":"h61LJ8HUIw"},{"type":"outputs","id":"z5Oi36dalgyFjXn2MX1iL","children":[],"key":"EJbzvbXoEX"}],"identifier":"e8275ed0-3f33-4513-b24f-40b044d35e13","html_id":"e8275ed0-3f33-4513-b24f-40b044d35e13","key":"GprUQRK0X6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making all 24 time steps into a GIF","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eLhgQDINx4"}],"identifier":"making-all-24-time-steps-into-a-gif","label":"Making all 24 time steps into a GIF","html_id":"making-all-24-time-steps-into-a-gif","implicit":true,"key":"Ssc0lKxkBS"}],"identifier":"b4dfd8a3-694c-4cf1-b6f3-d21293833af5","html_id":"b4dfd8a3-694c-4cf1-b6f3-d21293833af5","key":"DWrBbYlOZp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS map colors\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\n# Save each hourly rain-rate map as an image\n\nfor idx in range(len(dta.time)):\n\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5, 5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n    # Add timestamp to each frame\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    plt.title(\n        f\"\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.savefig(\n        f\"rain_rate_{idx:02d}.png\",\n        dpi=150,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()","key":"EDe1ONDbAO"},{"type":"outputs","id":"zmR1ztqDL_NvuAZnhS7eM","children":[],"key":"d3ISkODa36"}],"identifier":"1818ab37-fda2-432d-a405-2789ad28aee2","html_id":"1818ab37-fda2-432d-a405-2789ad28aee2","key":"NdUZzlKK7W"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Making the GIF\nfrom PIL import Image\n\nfiles = [f\"rain_rate_{i:02d}.png\" for i in range(len(dta.time))]\n\nframes = [Image.open(f).convert(\"RGB\") for f in files]\n\nframes[0].save(\n    \"ida_rainfall_evolution_24hr.gif\",\n    save_all=True,\n    append_images=frames[1:],\n    duration=500,\n    loop=0\n)","key":"YohqPkaoFf"},{"type":"outputs","id":"7q_GE-_jiWUcwVnJjjVGt","children":[],"key":"XcCLiZXjW9"}],"identifier":"d50ae765-2bd4-432b-9471-8f376af58244","html_id":"d50ae765-2bd4-432b-9471-8f376af58244","key":"wQiax20rcg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# displaying the GIF\nfrom IPython.display import Image as IPImage\nIPImage(filename=\"ida_rainfall_evolution_24hr.gif\")","key":"Y2hWT9IfIo"},{"type":"outputs","id":"A_ABs-HU4vWLDyTBy_MmH","children":[],"key":"xfc8oz1Ymi"}],"identifier":"6d560170-17fe-4ec1-b51d-2299d4c19ad0","html_id":"6d560170-17fe-4ec1-b51d-2299d4c19ad0","key":"l5yT6EhkSA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Figure: Animation of MPAS-A simulated rain rate during the remnants of Hurricane Ida from 13 UTC 1 September to 12 UTC 2 September 2021. The animation highlights the evolution and movement of heavy precipitation bands across the northeastern United States, with peak rainfall occurring during the evening hours of 1 September.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fjV149il3q"}],"key":"FZyDhvKPA7"}],"identifier":"f5ffdb10-8deb-435c-b093-50eea3403cda","html_id":"f5ffdb10-8deb-435c-b093-50eea3403cda","key":"EDqnZB7DXs"}],"key":"CXurz2ZH9v"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Data to use","url":"/notebooks/readme","group":"Examples"},"next":{"title":"Exploring High-Impact Rainfall from Hurricane Ida’s Remnants with MPAS-Viewer (Part 2)","url":"/notebooks/hurricane-ida-pt2","group":"Examples"}}},"domain":"http://localhost:3000"}