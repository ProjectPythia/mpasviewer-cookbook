01b[38;5;28;01mas\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21;01mpd\u001b[39;00m\n\n\u001b[0;31mModuleNotFoundError\u001b[0m: No module named 'ipywidgets'","ename":"ModuleNotFoundError","evalue":"No module named 'ipywidgets'"},"key":"DkXV3Fmt6o"}],"key":"G8WTZPNvBt"}],"identifier":"b7e19916-2257-4043-aadf-f4573950d447","html_id":"b7e19916-2257-4043-aadf-f4573950d447","key":"dUQM2xRXVI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Remote data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XzSYq2VjWs"}],"identifier":"remote-data","label":"Remote data","html_id":"remote-data","implicit":true,"key":"jPF6PkUKWU"}],"identifier":"65b19985-b91c-4aa2-8ff0-b7f39df031b4","html_id":"65b19985-b91c-4aa2-8ff0-b7f39df031b4","key":"q1uAp0u1km"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"url_thredds = \"https://thredds.hydroshare.org/thredds/catalog/hydroshare/resources/6be754bf29cb488b815810c35f3f0ac9/data/contents/nyc_out/catalog.html\"\n\ninidt = datetime(2021, 9, 1, 13)\nenddt = datetime(2021, 9, 2, 12)\n\nlist_files = scvtmesh.get_thredds_list(\n    url_thredds,\n    date_start=inidt,\n    date_end=enddt\n)\n\nlist_files[:3]","key":"LZYCbxKfKp"},{"type":"outputs","id":"X9uDc1x1fWdf8PkUY0sho","children":[],"key":"KcKONoX0IJ"}],"identifier":"efee8e96-a7b7-4406-8152-1865bdbb9d34","html_id":"efee8e96-a7b7-4406-8152-1865bdbb9d34","key":"wZs7JSfT0F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Initalizing MPAS-Viewer\ngrid_file = \"http://thredds.hydroshare.org/thredds/dodsC/hydroshare/resources/6be754bf29cb488b815810c35f3f0ac9/data/contents/nyc_static/nyc.static.nc\"\n\nmpasd = scvtmesh(\n    grid_file=grid_file,\n    diag_list=list_files\n)","key":"d2xq8oBust"},{"type":"outputs","id":"bSoxok4UHGvmGDYfxoPoa","children":[],"key":"Z29pmSFf9C"}],"identifier":"2324af77-a23d-463a-8c05-d964ff1c4dc0","html_id":"2324af77-a23d-463a-8c05-d964ff1c4dc0","key":"m8IEI4MewE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Loading in necessary variables\nload_vars = [\"rainnc\", \"rainc\", \"t2m\", \"olrtoa\", \"refl10cm_max\"]\n\nmpasd.dataset(load_variables=load_vars)\nmpasd.rain_rate()\n\ndta = mpasd.load()","key":"kh8qnb1Dn1"},{"type":"outputs","id":"n2rLkHW9E1_FsLDZsdSZf","children":[],"key":"YET9VuyrKq"}],"identifier":"78497c37-455c-4bed-8534-821c37328eda","html_id":"78497c37-455c-4bed-8534-821c37328eda","key":"kiwGKjHEeU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# double checking times and dates\nprint(dta)\nprint(dta[\"time\"].values)","key":"TLp0APszxL"},{"type":"outputs","id":"NgvqZBtmQKee-9gAD-Shz","children":[],"key":"OmYtHfoe1b"}],"identifier":"5b29d286-6838-415e-8d18-b1f6c5a001e2","html_id":"5b29d286-6838-415e-8d18-b1f6c5a001e2","key":"E0bJT6ticd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for i, t in enumerate(dta[\"time\"].values):\n    max_rain = dta[\"rain_rate\"].isel(time=i).max().compute().values\n    print(i, t, max_rain)","key":"YTP78XIaoh"},{"type":"outputs","id":"v9cN49Orql8gBwa6Ji3z0","children":[],"key":"rmrIFklHXU"}],"identifier":"a6597689-bd5d-4db5-bc91-226f828e034e","html_id":"a6597689-bd5d-4db5-bc91-226f828e034e","key":"GGpX7DNY2G"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Rain rate\nsubd = mpasd.get_subset(\n    dta,\n    lon=(-75, -71),\n    lat=(39, 42.5)\n)","key":"QhAnYmaRDe"},{"type":"outputs","id":"eqJYFJ2M4iBk91aB2VRFV","children":[],"key":"yUabluDfdr"}],"identifier":"a7c637f9-8a0c-40c2-8a90-1fe2684e266a","html_id":"a7c637f9-8a0c-40c2-8a90-1fe2684e266a","key":"f8GfZXBjY4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from earthcmap import escmap\n\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\nmpasd.show(\n    dta,\n    var_name=\"rain_rate\",\n    time_index=8,\n    figsize=(8,8),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"Rain Rate at 2100 UTC\",\n    pad=30,\n    x=0.57 #shifts the title to the center of the plot\n)","key":"o5nRhk0I4R"},{"type":"outputs","id":"55T9XJM3RgKC4eHOjxs8z","children":[],"key":"QEE9TGv64A"}],"identifier":"54aac3df-69ac-4e46-a336-76afd2732abc","html_id":"54aac3df-69ac-4e46-a336-76afd2732abc","key":"HdWfgn2qJH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Rain rate is used to identify the location and intensity of the heaviest precipitation associated with the remnants of Hurricane Ida.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u5uE4JNHAe"}],"key":"vi1K5Tlq2M"}],"identifier":"04e3398c-29c6-48c5-8e19-6594dbb2fc93","html_id":"04e3398c-29c6-48c5-8e19-6594dbb2fc93","key":"rsJqBNhGrF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reflectivity","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tPwpKeRpWE"}],"identifier":"reflectivity","label":"Reflectivity","html_id":"reflectivity","implicit":true,"key":"mIfi7AxrlH"}],"identifier":"1dc134f9-ff3f-4421-a092-e44c730b1f5e","html_id":"1dc134f9-ff3f-4421-a092-e44c730b1f5e","key":"fIHu1sLofk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cmap, norm = escmap(\"mrms_cref\")\n\nmpasd.show(\n    dta,\n    var_name=\"refl10cm_max\",\n    time_index=8,\n    figsize=(8,8),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"Maximum 10-cm Reflectivity at 2100 UTC\",\n    pad=30,\n    x=0.57\n)","key":"Arcs7mtt1V"},{"type":"outputs","id":"RTeMoxoPNaHe_RWeDFAIr","children":[],"key":"rssKc9bJVD"}],"identifier":"b9ca188c-218d-4718-ac83-c400378aa6aa","html_id":"b9ca188c-218d-4718-ac83-c400378aa6aa","key":"ozSwERHIjc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulated maximum reflectivity highlights regions of organized precipitation and convective structures during the event.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"epQp8ug8ez"}],"key":"m7Ir0n2ECJ"}],"identifier":"4f7bf8d4-9f8f-45a3-87fe-fec0a4292b23","html_id":"4f7bf8d4-9f8f-45a3-87fe-fec0a4292b23","key":"f9Lkn4PIpz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Outgoing Longwave Radiation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p1dMhMQP1h"}],"identifier":"outgoing-longwave-radiation","label":"Outgoing Longwave Radiation","html_id":"outgoing-longwave-radiation","implicit":true,"key":"VRnqo6Vkok"}],"identifier":"71e9e0c8-2dd9-4bda-a608-24fbcc977a49","html_id":"71e9e0c8-2dd9-4bda-a608-24fbcc977a49","key":"SPTlJtYuLb"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# importing for colormap usage\nimport matplotlib.colors as colors\ncmap = plt.get_cmap(\"gray_r\")\nnorm = colors.Normalize(vmin=100, vmax=320)\\\n\nmpasd.show(\n    dta,\n    var_name=\"olrtoa\",\n    time_index=8,\n    figsize=(8, 5),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"OLR at 2100 UTC\",\n    pad=30,\n    x=0.73\n)","key":"EC8bP4Kfnz"},{"type":"outputs","id":"-xU05SyH3EOq_jWNP1PvU","children":[],"key":"f5z4o9UdDR"}],"identifier":"e6bfd949-065d-452f-a63b-0a82703b29bd","html_id":"e6bfd949-065d-452f-a63b-0a82703b29bd","key":"d6zcNZ9cHx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Outgoing longwave radiation (OLR) provides information about cloud-top characteristics, with lower values generally associated with deeper convection and colder cloud tops.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CkqxOHod4x"}],"key":"K8JH0g1EHN"}],"identifier":"3fa8b968-9436-4886-a447-5f7c4f0a39e2","html_id":"3fa8b968-9436-4886-a447-5f7c4f0a39e2","key":"rV6pg8Aprt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Evolution of Rainfall During Hurricane Ida","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dGChMHaytZ"}],"identifier":"evolution-of-rainfall-during-hurricane-ida","label":"Evolution of Rainfall During Hurricane Ida","html_id":"evolution-of-rainfall-during-hurricane-ida","implicit":true,"key":"BOOh7Vd356"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"To better understand the temporal evolution of the event, we create an animation of simulated rain rate from 13 UTC 1 September through 12 UTC 2 September 2021. This animation highlights the development, intensification, and movement of precipitation associated with the remnants of Hurricane Ida.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XIv1RxLBmE"}],"key":"oqmm65HM2u"}],"identifier":"23af8f56-cd7a-4425-9d5e-2762f204eb9d","html_id":"23af8f56-cd7a-4425-9d5e-2762f204eb9d","key":"C2Hq0bt6lL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Install Imageio to make a gif","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mlgDy4Zgit"}],"identifier":"install-imageio-to-make-a-gif","label":"Install Imageio to make a gif","html_id":"install-imageio-to-make-a-gif","implicit":true,"key":"hpHyubeluJ"}],"identifier":"a8a23965-26fc-4961-8327-045a44f923ab","html_id":"a8a23965-26fc-4961-8327-045a44f923ab","key":"LZamf5OKqb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"!pip install imageio","key":"gxLHBPyHgx"},{"type":"outputs","id":"N2LUPoFBwUraWQQ7jqTnZ","children":[],"key":"A2cda6ucUY"}],"identifier":"c7e23b8d-56ad-45b9-bdf0-2fc53d5f8f28","html_id":"c7e23b8d-56ad-45b9-bdf0-2fc53d5f8f28","key":"M580p65qyU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plotting 3 time frames before peak, during peak and after peak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YMPPTXB9j2"}],"identifier":"plotting-3-time-frames-before-peak-during-peak-and-after-peak","label":"Plotting 3 time frames before peak, during peak and after peak","html_id":"plotting-3-time-frames-before-peak-during-peak-and-after-peak","implicit":true,"key":"knDLHJmova"}],"identifier":"c309e50e-94bf-4818-b117-346dd3252001","html_id":"c309e50e-94bf-4818-b117-346dd3252001","key":"tU8K1gxrQb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS Color QPE colormaps\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\n# Select representative times showing the evolution of rainfall: before peak intensity, during peak intensity, and after the event begins to weaken.\ntimes = [6, 8, 15]\n\nfor idx in times:\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5,5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n     # Add timestamp to each frame\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    ax = plt.gca()\n    plt.title(\n        f\"\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.savefig(\n        f\"rain_rate_{idx:02d}.png\",\n        dpi=150,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()","key":"ECdhltIlRO"},{"type":"outputs","id":"l1JCQX54yr0ocCPovc5Jm","children":[],"key":"aM0PoV1HTv"}],"identifier":"58053a3f-6ba8-4717-bbe3-317db3df92ff","html_id":"58053a3f-6ba8-4717-bbe3-317db3df92ff","key":"YR1sURnChY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS map colors\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\ntimes = [6, 8, 15]\n\nfor idx in times:\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5, 5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    ax = plt.gca()\n    ax.set_title(\n        f\"Rain Rate\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.show()","key":"x0SDQppZ4i"},{"type":"outputs","id":"a0zPxMJ9ZXsmd5bSYm0rW","children":[],"key":"wbTnI7PUCn"}],"identifier":"e8275ed0-3f33-4513-b24f-40b044d35e13","html_id":"e8275ed0-3f33-4513-b24f-40b044d35e13","key":"VHIo02Dlkq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making all 24 time steps into a GIF","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"trSM0am8B7"}],"identifier":"making-all-24-time-steps-into-a-gif","label":"Making all 24 time steps into a GIF","html_id":"making-all-24-time-steps-into-a-gif","implicit":true,"key":"ZGxaJsgbTx"}],"identifier":"b4dfd8a3-694c-4cf1-b6f3-d21293833af5","html_id":"b4dfd8a3-694c-4cf1-b6f3-d21293833af5","key":"XbH1Xojtso"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS map colors\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\n# Save each hourly rain-rate map as an image\n\nfor idx in range(len(dta.time)):\n\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5, 5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n    # Add timestamp to each frame\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    plt.title(\n        f\"\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.savefig(\n        f\"rain_rate_{idx:02d}.png\",\n        dpi=150,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()","key":"aJbqKvEP1p"},{"type":"outputs","id":"hdrBJKh7WpzyEtr47RoPI","children":[],"key":"Bk9honKeMb"}],"identifier":"1818ab37-fda2-432d-a405-2789ad28aee2","html_id":"1818ab37-fda2-432d-a405-2789ad28aee2","key":"mImhdwjnGC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Making the GIF\nfrom PIL import Image\n\nfiles = [f\"rain_rate_{i:02d}.png\" for i in range(len(dta.time))]\n\nframes = [Image.open(f).convert(\"RGB\") for f in files]\n\nframes[0].save(\n    \"ida_rainfall_evolution_24hr.gif\",\n    save_all=True,\n    append_images=frames[1:],\n    duration=500,\n    loop=0\n)","key":"daWFqkLxFu"},{"type":"outputs","id":"fZuBUEEoyaGLJ7WD4WN3J","children":[],"key":"X2xdQDYSHH"}],"identifier":"d50ae765-2bd4-432b-9471-8f376af58244","html_id":"d50ae765-2bd4-432b-9471-8f376af58244","key":"fOfL0uGxRb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# displaying the GIF\nfrom IPython.display import Image as IPImage\nIPImage(filename=\"ida_rainfall_evolution_24hr.gif\")","key":"jQUHNVzPpD"},{"type":"outputs","id":"aRTUPvX32rN_hZMdpkh8W","children":[],"key":"up5Hg7RUBa"}],"identifier":"6d560170-17fe-4ec1-b51d-2299d4c19ad0","html_id":"6d560170-17fe-4ec1-b51d-2299d4c19ad0","key":"bP3EtEalbN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Figure: Animation of MPAS-A simulated rain rate during the remnants of Hurricane Ida from 13 UTC 1 September to 12 UTC 2 September 2021. The animation highlights the evolution and movement of heavy precipitation bands across the northeastern United States, with peak rainfall occurring during the evening hours of 1 September.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LYmWq2BjWp"}],"key":"jOZv1efmwx"}],"identifier":"f5ffdb10-8deb-435c-b093-50eea3403cda","html_id":"f5ffdb10-8deb-435c-b093-50eea3403cda","key":"OnfONMRsMo"}],"key":"Tp9isNRbjU"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Data to use","url":"/notebooks/readme","group":"Examples"},"next":{"title":"Exploring High-Impact Rainfall from Hurricane Ida’s Remnants with MPAS-Viewer (Part 2)","url":"/notebooks/hurricane-ida-pt2","group":"Examples"}}},"domain":"http://pre.render"}