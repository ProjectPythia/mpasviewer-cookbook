,"identifier":"20d5b6f6-0e67-45dd-abbb-25b28e16df5e","html_id":"20d5b6f6-0e67-45dd-abbb-25b28e16df5e","key":"aAwOQkC6Qz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Build first collection only to get projection / CRS\nfirst_coll = mpasd.collection(subd, var_name, time_index=0, crs=crs, figsize=figsize, cmap=cmap,norm=None, vmin=vmin, vmax=vmax,)","key":"YIaZq2hg7l"},{"type":"outputs","id":"t_aKTHDmVlTahegUL5WSQ","children":[],"key":"EUPibsJ7Qs"}],"identifier":"5e090d5f-f5d4-4575-8506-f146157c9924","html_id":"5e090d5f-f5d4-4575-8506-f146157c9924","key":"MHhTeU3AKE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=figsize,subplot_kw={\"projection\": first_coll.crs},)\n\n# One persistent colorbar axis\npos = ax.get_position()\ncbar_ax = fig.add_axes([pos.x1 + 0.01, pos.y0, 0.02, pos.height,])\n\ncurrent_cbar = None\n\ndef draw_frame(i):\n    global current_cbar\n\n    ax.clear()\n    cbar_ax.clear()\n\n    coll = mpasd.collection(subd,var_name, level=level,time_index=i, crs=crs,figsize=figsize, cmap=cmap,vmin=vmin, vmax=vmax, )\n\n    ax.add_collection(coll)\n    ax.autoscale_view()\n\n    ax.set_xlabel(\"Longitude\")\n    ax.set_ylabel(\"Latitude\")\n    ax.set_title(f\"{coll.vname}\\n\", loc=\"left\")\n    ax.set_title(f\"\\n{coll.stime}\", loc=\"right\")\n\n    ax.coastlines(linewidth=0.5)\n\n    if coll.limits[1] >= 179.5 and coll.limits[0] <= -179.5:\n        ax.set_global()\n    else:\n        ax.set_extent(coll.limits, crs=ccrs.PlateCarree())\n\n    gl = ax.gridlines(crs=ccrs.PlateCarree(), draw_labels=True, linewidth=0.7, color=\"gray\", alpha=0.5, linestyle=\"--\", dms=True,)\n    gl.top_labels = False\n    gl.right_labels = False\n\n    fig.colorbar(coll, cax=cbar_ax, label=var_name)\n\n    return [coll]\n\n# Draw initial frame\ndraw_frame(0)\n\nani = FuncAnimation(fig,draw_frame,frames=ntime,interval=200,blit=False,)\n\n#HTML(ani.to_jshtml())","key":"NKb6lz98Lj"},{"type":"outputs","id":"UTWjJcyBKAM4Z5j9Ca4BN","children":[],"key":"xWdrRo406a"}],"identifier":"8183673a-ec62-4c07-86b7-9cf05589274a","html_id":"8183673a-ec62-4c07-86b7-9cf05589274a","key":"iwQLrffJLV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"slEpejsAJi"}],"identifier":"step-4","label":"Step 4","html_id":"step-4","implicit":true,"key":"vE0qhqudMC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Save animation as gif","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Hi8Rt89yyI"}],"key":"AvbTCZ1k6q"}],"identifier":"5c2e0b42-b848-4852-ac2c-ee7a6b95d1cd","html_id":"5c2e0b42-b848-4852-ac2c-ee7a6b95d1cd","key":"spFhc7dSfz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ani.save(\"hurricane.gif\", writer=PillowWriter(fps=5))","key":"b3WiqsFeJE"},{"type":"outputs","id":"0nLJghTkw_sIPOATtbgH3","children":[],"key":"HSVp5Rn1AX"}],"identifier":"1f886861-9a64-4397-8fd5-bcdd729c7868","html_id":"1f886861-9a64-4397-8fd5-bcdd729c7868","key":"JstK5Ha6wf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"OirXqqV2Iw"},{"type":"outputs","id":"pRHGdTHvS-kgVITw2BhlK","children":[],"key":"DTAyKyqTM6"}],"identifier":"2ec070c6-8543-4de1-a5cc-bfc15e15881f","html_id":"2ec070c6-8543-4de1-a5cc-bfc15e15881f","key":"sEkBu8ac1r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"mql6vGCuGT"},{"type":"outputs","id":"Wfvd-6RAunJ28zv1zK8KO","children":[],"key":"D6f40D8Njk"}],"identifier":"cc33fae9-9b98-4963-abce-55f1b6c82117","html_id":"cc33fae9-9b98-4963-abce-55f1b6c82117","key":"MRchXU7U3e"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 5","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sOs4N361nY"}],"identifier":"step-5","label":"Step 5","html_id":"step-5","implicit":true,"key":"WBOP8JC7eN"}],"identifier":"78f1eff1-b6f4-4ed6-a610-8b13476cd068","html_id":"78f1eff1-b6f4-4ed6-a610-8b13476cd068","key":"kNFJrOtwY9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"var_name = \"t2m\"\nlevel = None\nfigsize = (8, 8)\ncmap = plt.get_cmap('Spectral',100)\nnorm = None\nvmin = 270\nvmax = 310\ncrs = ccrs.PlateCarree()\nntime = subd.sizes[\"time\"]","key":"uAJF2vEGJM"},{"type":"outputs","id":"hLA-xaCTSRGkncFuM3XLf","children":[],"key":"mXx411qjwA"}],"identifier":"e1027f7f-832d-4e56-8e2d-4472b57bdab8","html_id":"e1027f7f-832d-4e56-8e2d-4472b57bdab8","key":"tW0nfsc08r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Build first collection only to get projection / CRS\nfirst_coll = mpasd.collection(subd, var_name, time_index=0, crs=crs, figsize=figsize, cmap=cmap,norm=None, vmin=vmin, vmax=vmax,)","key":"ib69G5uOhb"},{"type":"outputs","id":"JFo3rH4xxhlm16-aRfQ97","children":[],"key":"jDA7BOvjEh"}],"identifier":"40f8947c-8a24-4222-b779-c7cdecac291c","html_id":"40f8947c-8a24-4222-b779-c7cdecac291c","key":"b5ePTKxsBy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=figsize,subplot_kw={\"projection\": first_coll.crs},)\n\n# One persistent colorbar axis\npos = ax.get_position()\ncbar_ax = fig.add_axes([pos.x1 + 0.01, pos.y0, 0.02, pos.height,])\n\ncurrent_cbar = None\n\ndef draw_frame(i):\n    global current_cbar\n\n    ax.clear()\n    cbar_ax.clear()\n\n    coll = mpasd.collection(subd,var_name, level=level,time_index=i, crs=crs,figsize=figsize, cmap=cmap,vmin=vmin, vmax=vmax, )\n\n    ax.add_collection(coll)\n    ax.autoscale_view()\n\n    ax.set_xlabel(\"Longitude\")\n    ax.set_ylabel(\"Latitude\")\n    ax.set_title(f\"{coll.vname}\\n\", loc=\"left\")\n    ax.set_title(f\"\\n{coll.stime}\", loc=\"right\")\n\n    ax.coastlines(linewidth=0.5)\n\n    if coll.limits[1] >= 179.5 and coll.limits[0] <= -179.5:\n        ax.set_global()\n    else:\n        ax.set_extent(coll.limits, crs=ccrs.PlateCarree())\n\n        # --- wind quivers ---\n    stride = 25\n\n    lon = subd[\"face_x\"].values\n    lat = subd[\"face_y\"].values\n\n    u = subd[\"uzonal\"].isel(time=i, nPresLevels=0).values\n    v = subd[\"umeridional\"].isel(time=i, nPresLevels=0).values\n\n    #q = ax.quiver(lon, lat, u, v, transform=ccrs.PlateCarree(), scale=500, width=0.002, zorder=5,)\n    q = ax.quiver(lon[::stride], lat[::stride], u[::stride], v[::stride], width=0.002,scale=3000, zorder=5,transform=ccrs.PlateCarree(),)\n\n    #ax.quiverkey(q,X=0.88,Y=-0.08, U=10, label=\"10 m/s\",labelpos=\"E\",)\n\n\n    gl = ax.gridlines(crs=ccrs.PlateCarree(), draw_labels=True, linewidth=0.7, color=\"gray\", alpha=0.5, linestyle=\"--\", dms=True,)\n    gl.top_labels = False\n    gl.right_labels = False\n\n    fig.colorbar(coll, cax=cbar_ax, label=var_name)\n\n    return [coll]\n\n# Draw initial frame\ndraw_frame(0)\n\nani = FuncAnimation(fig,draw_frame,frames=ntime,interval=200,blit=False,)","key":"j4wtlzwb0k"},{"type":"outputs","id":"Vf_0wb96Gf8V098XQWRqd","children":[],"key":"MxENVUbCmj"}],"identifier":"fd7e76d7-7352-422f-a7ef-193f0e13b042","html_id":"fd7e76d7-7352-422f-a7ef-193f0e13b042","key":"UmBe8xiE0f"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"j3R1fFnwQj"},{"type":"outputs","id":"oIMpFK5dRiNKuQI4jFzPG","children":[],"key":"HRkGIhMj2E"}],"identifier":"9424186a-b908-43c6-a04a-fb3331496210","html_id":"9424186a-b908-43c6-a04a-fb3331496210","key":"jylS3hLsc1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=figsize,subplot_kw={\"projection\": first_coll.crs},)\n\n# One persistent colorbar axis\npos = ax.get_position()\ncbar_ax = fig.add_axes([pos.x1 + 0.01, pos.y0, 0.02, pos.height,])\n\ncurrent_cbar = None\n\ndef draw_frame(i):\n    global current_cbar\n\n    ax.clear()\n    cbar_ax.clear()\n\n    coll = mpasd.collection(subd,var_name, level=level,time_index=i, crs=crs,figsize=figsize, cmap=cmap,vmin=vmin, vmax=vmax, )\n\n    ax.add_collection(coll)\n    ax.autoscale_view()\n\n    ax.set_xlabel(\"Longitude\")\n    ax.set_ylabel(\"Latitude\")\n    ax.set_title(f\"{coll.vname}\\n\", loc=\"left\")\n    ax.set_title(f\"\\n{coll.stime}\", loc=\"right\")\n\n    ax.coastlines(linewidth=0.5)\n\n    if coll.limits[1] >= 179.5 and coll.limits[0] <= -179.5:\n        ax.set_global()\n    else:\n        ax.set_extent(coll.limits, crs=ccrs.PlateCarree())\n\n        # --- wind quivers ---\n    stride = 25\n\n    lon = subd[\"face_x\"].values\n    lat = subd[\"face_y\"].values\n\n    u = subd[\"uzonal\"].isel(time=i, nPresLevels=0).values\n    v = subd[\"umeridional\"].isel(time=i, nPresLevels=0).values\n\n    #q = ax.quiver(lon, lat, u, v, transform=ccrs.PlateCarree(), scale=500, width=0.002, zorder=5,)\n    q = ax.quiver(lon[::stride], lat[::stride], u[::stride], v[::stride], width=0.002,scale=3000, zorder=5,transform=ccrs.PlateCarree(),)\n\n    #ax.quiverkey(q,X=0.88,Y=-0.08, U=10, label=\"10 m/s\",labelpos=\"E\",)\n\n\n    gl = ax.gridlines(crs=ccrs.PlateCarree(), draw_labels=True, linewidth=0.7, color=\"gray\", alpha=0.5, linestyle=\"--\", dms=True,)\n    gl.top_labels = False\n    gl.right_labels = False\n\n    fig.colorbar(coll, cax=cbar_ax, label=var_name)\n\n    return [coll]\n\n# Draw initial frame\ndraw_frame(0)\n\nani = FuncAnimation(fig,draw_frame,frames=ntime,interval=200,blit=False,)","key":"F06ojXDolb"},{"type":"outputs","id":"eikDAdKL__PK1r4-u3GIm","children":[],"key":"dKEp2HFyt4"}],"identifier":"9703c4f5-00ec-42e9-ad4c-8708b2def929","html_id":"9703c4f5-00ec-42e9-ad4c-8708b2def929","key":"vZ4K5hZxPO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"kjBs8MfaDs"},{"type":"outputs","id":"8hoXHMso2l5E2Yz5_2N12","children":[],"key":"FUB77LB4eF"}],"identifier":"25b85302-23b2-45a8-8876-10e7e8f6926a","html_id":"25b85302-23b2-45a8-8876-10e7e8f6926a","key":"XnBcJf3gd5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"var_name = \"rain_rate\"\nlevel = None\nfigsize = (12, 8)\ncmap = plt.get_cmap('Spectral',100)\nnorm = None\nvmin = 0\nvmax = 100\ncrs = ccrs.PlateCarree()\nntime = subd.sizes[\"time\"]","key":"hxrNU1HiEA"},{"type":"outputs","id":"0sx0gtxTEAe5oGjJEuQwx","children":[],"key":"T2kUhADJuQ"}],"identifier":"33d5c05e-b20b-4863-87ae-f45daa6705b3","html_id":"33d5c05e-b20b-4863-87ae-f45daa6705b3","key":"xHxvKyl8Ry"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Build first collection only to get projection / CRS\nfirst_coll = mpasd.collection(subd, var_name, time_index=0, crs=crs, figsize=figsize, cmap=cmap,norm=None, vmin=vmin, vmax=vmax,)","key":"YWRSrfxSRc"},{"type":"outputs","id":"bg97mrKmOMET88zTM61ud","children":[],"key":"Q4j4vkf56f"}],"identifier":"c5ef4a1e-93e4-4876-8897-3b7f94f19688","html_id":"c5ef4a1e-93e4-4876-8897-3b7f94f19688","key":"NGi5I875nL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(12, 8))\n\ngs = fig.add_gridspec(2, 2)\n\n# Map panel: Cartopy / PlateCarree\nax0 = fig.add_subplot(gs[0, 0], projection=ccrs.PlateCarree())\n\n# Regular Matplotlib panels\nax1 = fig.add_subplot(gs[0, 1])\nax2 = fig.add_subplot(gs[1, 0])\nax3 = fig.add_subplot(gs[1, 1])\n\n\n# One persistent colorbar axis\npos = ax0.get_position()\ncbar_ax = fig.add_axes([pos.x1 + 0.02, pos.y0+0.03, 0.03, pos.height,])\n\ncurrent_cbar = None\n\ndef draw_frame(i):\n    global current_cbar\n\n    ax0.clear()\n    cbar_ax.clear()\n\n    coll = mpasd.collection(subd,var_name, level=level,time_index=i, crs=crs,figsize=figsize, cmap=cmap,vmin=vmin, vmax=vmax, )\n\n    ax0.add_collection(coll)\n    ax0.autoscale_view()\n\n    ax0.set_xlabel(\"Longitude\")\n    ax0.set_ylabel(\"Latitude\")\n    ax0.set_title(f\"{coll.vname}\\n\", loc=\"left\")\n    ax0.set_title(f\"\\n{coll.stime}\", loc=\"right\")\n\n    ax0.coastlines(linewidth=0.5)\n\n    if coll.limits[1] >= 179.5 and coll.limits[0] <= -179.5:\n        ax0.set_global()\n    else:\n        ax0.set_extent(coll.limits, crs=ccrs.PlateCarree())\n\n        # --- wind quivers ---\n    stride = 25\n\n    lon = subd[\"face_x\"].values\n    lat = subd[\"face_y\"].values\n\n    u = subd[\"uzonal\"].isel(time=i, nPresLevels=0).values\n    v = subd[\"umeridional\"].isel(time=i, nPresLevels=0).values\n\n    q = ax0.quiver(lon[::stride], lat[::stride], u[::stride], v[::stride], width=0.002,scale=3000, zorder=5,transform=crs,)\n    #ax[0][0].quiverkey(q,X=0.88,Y=-0.08, U=10, label=\"10 m/s\",labelpos=\"E\",)\n\n    slp_t = subd['mslp'].isel(time=i)\n\n    center_cell = int(slp_t.argmin(dim=\"face\"))\n    \n    center_lat = float(subd['face_x'].isel(face=center_cell))\n    center_lon = float(subd['face_y'].isel(face=center_cell))\n    center_slp = float(slp_t.isel(face=center_cell))\n\n    ax0.scatter(center_lat, center_lon)\n    ax0.set_title('')\n\n    gl = ax0.gridlines(crs=ccrs.PlateCarree(), draw_labels=True, linewidth=0.7, color=\"gray\", alpha=0.5, linestyle=\"--\", dms=True,)\n    gl.top_labels = False\n    gl.right_labels = False\n\n\n\n    ax1.clear()\n\n    subd['ws'] = (subd['uzonal']**2 + subd['umeridional']**2)**(1/2)\n    subd.isel(face=center_cell)['ws'].isel(time=i).plot.line(y='nPresLevels', ax=ax1, yincrease=False)\n    ax1.set_title('')\n    ax1.set_xlim(0,20)\n\n\n    ax2.clear()\n    subd.isel(face=center_cell)['temperature'].isel(time=i).plot.line(y='nPresLevels', ax=ax2, yincrease=False)\n    ax2.set_title('')\n\n\n    ax3.clear()\n    subd.isel(face=center_cell)['relhum'].isel(time=i).plot.line(y='nPresLevels', ax=ax3, yincrease=False)\n    ax3.set_title('')\n    ax3.set_xlim(0,100)\n\n\n    fig.colorbar(coll, cax=cbar_ax, label='')\n\n    fig.tight_layout()\n    \n    return [coll]\n\n# Draw initial frame\ndraw_frame(0)\n\nani = FuncAnimation(fig,draw_frame,frames=ntime,interval=200,blit=False,)\n\nHTML(ani.to_jshtml())","key":"nba3x4HvFk"},{"type":"outputs","id":"U7f4DWz6uHKiFaDfJ5r-q","children":[],"key":"YZdTItY3QD"}],"identifier":"491089ca-2d71-41b6-a52a-7fd700ad9298","html_id":"491089ca-2d71-41b6-a52a-7fd700ad9298","key":"YKOVwLlK52"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ani.save(\"hurricane_panels.gif\", writer=PillowWriter(fps=5))","key":"MkFjzLvK5Q"},{"type":"outputs","id":"xzA6Ho7ZeciaZD_7cPoWI","children":[],"key":"vsyAfveUGo"}],"identifier":"57824847-943f-49d5-bac7-37c1ba7b2569","html_id":"57824847-943f-49d5-bac7-37c1ba7b2569","key":"nccvHGt64v"}],"key":"x0ZS1oIUMM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Exploring High-Impact Rainfall from Hurricane Ida’s Remnants with MPAS-Viewer (Part 2)","url":"/notebooks/hurricane-ida-pt2","group":"Examples"}}},"domain":"http://pre.render"}