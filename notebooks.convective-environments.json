b[38;5;28;01mas\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21;01mpd\u001b[39;00m\n\n\u001b[0;31mModuleNotFoundError\u001b[0m: No module named 'ipywidgets'","ename":"ModuleNotFoundError","evalue":"No module named 'ipywidgets'"},"key":"cEdVTJNPYv"}],"key":"ED5QIew4Sy"}],"identifier":"b7e19916-2257-4043-aadf-f4573950d447","html_id":"b7e19916-2257-4043-aadf-f4573950d447","key":"o7ehWwB04w"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Remote data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gemA7QMH1p"}],"identifier":"remote-data","label":"Remote data","html_id":"remote-data","implicit":true,"key":"rY6y1GNmFH"}],"identifier":"65b19985-b91c-4aa2-8ff0-b7f39df031b4","html_id":"65b19985-b91c-4aa2-8ff0-b7f39df031b4","key":"KqlKUfcfUg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"url_thredds = \"https://thredds.hydroshare.org/thredds/catalog/hydroshare/resources/6be754bf29cb488b815810c35f3f0ac9/data/contents/nyc_out/catalog.html\"\n\ninidt = datetime(2021, 9, 1, 13)\nenddt = datetime(2021, 9, 2, 12)\n\nlist_files = scvtmesh.get_thredds_list(\n    url_thredds,\n    date_start=inidt,\n    date_end=enddt\n)\n\nlist_files[:3]","key":"QfrHjtS8pd"},{"type":"outputs","id":"nkJ6ihqUM_Y8K-wIAvSGP","children":[],"key":"vrQugJCE9W"}],"identifier":"efee8e96-a7b7-4406-8152-1865bdbb9d34","html_id":"efee8e96-a7b7-4406-8152-1865bdbb9d34","key":"fGVAsISIDr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Initalizing MPAS-Viewer\ngrid_file = \"http://thredds.hydroshare.org/thredds/dodsC/hydroshare/resources/6be754bf29cb488b815810c35f3f0ac9/data/contents/nyc_static/nyc.static.nc\"\n\nmpasd = scvtmesh(\n    grid_file=grid_file,\n    diag_list=list_files\n)","key":"V8dKASG34a"},{"type":"outputs","id":"VloCJ1z10wXZQg4W61Dad","children":[],"key":"s60YWrAYBK"}],"identifier":"2324af77-a23d-463a-8c05-d964ff1c4dc0","html_id":"2324af77-a23d-463a-8c05-d964ff1c4dc0","key":"cPUBTzAcq8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Loading in necessary variables\nload_vars = [\"rainnc\", \"rainc\", \"t2m\", \"olrtoa\", \"refl10cm_max\"]\n\nmpasd.dataset(load_variables=load_vars)\nmpasd.rain_rate()\n\ndta = mpasd.load()","key":"tkVc4zxw3y"},{"type":"outputs","id":"63_dC5Y7krAkz9_7F1S9W","children":[],"key":"CWJvsq72Kn"}],"identifier":"78497c37-455c-4bed-8534-821c37328eda","html_id":"78497c37-455c-4bed-8534-821c37328eda","key":"eaPEf2vuLC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# double checking times and dates\nprint(dta)\nprint(dta[\"time\"].values)","key":"cJiJiDbhWN"},{"type":"outputs","id":"8G1anE07WMhn0w-m9X0rf","children":[],"key":"a4ImTTToIN"}],"identifier":"5b29d286-6838-415e-8d18-b1f6c5a001e2","html_id":"5b29d286-6838-415e-8d18-b1f6c5a001e2","key":"fauFEYKE0F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for i, t in enumerate(dta[\"time\"].values):\n    max_rain = dta[\"rain_rate\"].isel(time=i).max().compute().values\n    print(i, t, max_rain)","key":"Nrx4SkbbTB"},{"type":"outputs","id":"PbnZiyF1x6Sg1OLbwJGzl","children":[],"key":"GH6zbnBsE8"}],"identifier":"a6597689-bd5d-4db5-bc91-226f828e034e","html_id":"a6597689-bd5d-4db5-bc91-226f828e034e","key":"qWMMvQgl5r"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Rain rate\nsubd = mpasd.get_subset(\n    dta,\n    lon=(-75, -71),\n    lat=(39, 42.5)\n)","key":"Cz0bVDQzPY"},{"type":"outputs","id":"T4Y5MHzamg20hT6XtIaEh","children":[],"key":"I8vlzCzWZ0"}],"identifier":"a7c637f9-8a0c-40c2-8a90-1fe2684e266a","html_id":"a7c637f9-8a0c-40c2-8a90-1fe2684e266a","key":"Udr8gA96mA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from earthcmap import escmap\n\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\nmpasd.show(\n    dta,\n    var_name=\"rain_rate\",\n    time_index=8,\n    figsize=(8,8),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"Rain Rate at 2100 UTC\",\n    pad=30,\n    x=0.57 #shifts the title to the center of the plot\n)","key":"ts0yLkUh0M"},{"type":"outputs","id":"6KaUAN7BFvpzEAeGcLDAQ","children":[],"key":"BVwQSxiyEw"}],"identifier":"54aac3df-69ac-4e46-a336-76afd2732abc","html_id":"54aac3df-69ac-4e46-a336-76afd2732abc","key":"OZpueGh8JP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Rain rate is used to identify the location and intensity of the heaviest precipitation associated with the remnants of Hurricane Ida.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KAKaNPFElE"}],"key":"iX6ADbTPUS"}],"identifier":"04e3398c-29c6-48c5-8e19-6594dbb2fc93","html_id":"04e3398c-29c6-48c5-8e19-6594dbb2fc93","key":"k7OPO4xoaI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reflectivity","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PWP1qd5TK2"}],"identifier":"reflectivity","label":"Reflectivity","html_id":"reflectivity","implicit":true,"key":"uq550fdfwj"}],"identifier":"1dc134f9-ff3f-4421-a092-e44c730b1f5e","html_id":"1dc134f9-ff3f-4421-a092-e44c730b1f5e","key":"STewKYAlii"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"cmap, norm = escmap(\"mrms_cref\")\n\nmpasd.show(\n    dta,\n    var_name=\"refl10cm_max\",\n    time_index=8,\n    figsize=(8,8),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"Maximum 10-cm Reflectivity at 2100 UTC\",\n    pad=30,\n    x=0.57\n)","key":"Z4VhTPYzKg"},{"type":"outputs","id":"ViBJAGdTO4MWWpUUHRCeu","children":[],"key":"TSftIzKEHk"}],"identifier":"b9ca188c-218d-4718-ac83-c400378aa6aa","html_id":"b9ca188c-218d-4718-ac83-c400378aa6aa","key":"WM56OD3uG3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulated maximum reflectivity highlights regions of organized precipitation and convective structures during the event.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rTRVam2D1C"}],"key":"L68hNkDH91"}],"identifier":"4f7bf8d4-9f8f-45a3-87fe-fec0a4292b23","html_id":"4f7bf8d4-9f8f-45a3-87fe-fec0a4292b23","key":"JQOP23JX8a"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Outgoing Longwave Radiation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"haDs2AZY0v"}],"identifier":"outgoing-longwave-radiation","label":"Outgoing Longwave Radiation","html_id":"outgoing-longwave-radiation","implicit":true,"key":"v0ZirvZCPp"}],"identifier":"71e9e0c8-2dd9-4bda-a608-24fbcc977a49","html_id":"71e9e0c8-2dd9-4bda-a608-24fbcc977a49","key":"VdZi48HAMf"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# importing for colormap usage\nimport matplotlib.colors as colors\ncmap = plt.get_cmap(\"gray_r\")\nnorm = colors.Normalize(vmin=100, vmax=320)\\\n\nmpasd.show(\n    dta,\n    var_name=\"olrtoa\",\n    time_index=8,\n    figsize=(8, 5),\n    cmap=cmap,\n    norm=norm,\n)\nplt.title(\n    \"OLR at 2100 UTC\",\n    pad=30,\n    x=0.73\n)","key":"AGLATpbkvL"},{"type":"outputs","id":"HEsfflyJbyyxY8X451ade","children":[],"key":"Nxg2ZvBmHY"}],"identifier":"e6bfd949-065d-452f-a63b-0a82703b29bd","html_id":"e6bfd949-065d-452f-a63b-0a82703b29bd","key":"eLFIkMENSj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Outgoing longwave radiation (OLR) provides information about cloud-top characteristics, with lower values generally associated with deeper convection and colder cloud tops.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E16j9Kfwi5"}],"key":"sNIdk30F2N"}],"identifier":"3fa8b968-9436-4886-a447-5f7c4f0a39e2","html_id":"3fa8b968-9436-4886-a447-5f7c4f0a39e2","key":"UJ2nSnUcyo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Evolution of Rainfall During Hurricane Ida","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LWtfuYtMry"}],"identifier":"evolution-of-rainfall-during-hurricane-ida","label":"Evolution of Rainfall During Hurricane Ida","html_id":"evolution-of-rainfall-during-hurricane-ida","implicit":true,"key":"g7bZn4SpaV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"To better understand the temporal evolution of the event, we create an animation of simulated rain rate from 13 UTC 1 September through 12 UTC 2 September 2021. This animation highlights the development, intensification, and movement of precipitation associated with the remnants of Hurricane Ida.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lJe5JvFAkt"}],"key":"JGqRXk8PrM"}],"identifier":"23af8f56-cd7a-4425-9d5e-2762f204eb9d","html_id":"23af8f56-cd7a-4425-9d5e-2762f204eb9d","key":"Y23jIbICyS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Install Imageio to make a gif","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XJhDWWpH1j"}],"identifier":"install-imageio-to-make-a-gif","label":"Install Imageio to make a gif","html_id":"install-imageio-to-make-a-gif","implicit":true,"key":"pis8oNt5Fw"}],"identifier":"a8a23965-26fc-4961-8327-045a44f923ab","html_id":"a8a23965-26fc-4961-8327-045a44f923ab","key":"g4ekRVcq0a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"!pip install imageio","key":"paDspuIH74"},{"type":"outputs","id":"VNlvo5HKgQ-y7wCr3Cubn","children":[],"key":"b90r7g9oEl"}],"identifier":"c7e23b8d-56ad-45b9-bdf0-2fc53d5f8f28","html_id":"c7e23b8d-56ad-45b9-bdf0-2fc53d5f8f28","key":"pQMnOh6Odt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plotting 3 time frames before peak, during peak and after peak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ai09Wvalqa"}],"identifier":"plotting-3-time-frames-before-peak-during-peak-and-after-peak","label":"Plotting 3 time frames before peak, during peak and after peak","html_id":"plotting-3-time-frames-before-peak-during-peak-and-after-peak","implicit":true,"key":"WFNnj9fmBd"}],"identifier":"c309e50e-94bf-4818-b117-346dd3252001","html_id":"c309e50e-94bf-4818-b117-346dd3252001","key":"HKO3HNICeP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS Color QPE colormaps\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\n# Select representative times showing the evolution of rainfall: before peak intensity, during peak intensity, and after the event begins to weaken.\ntimes = [6, 8, 15]\n\nfor idx in times:\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5,5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n     # Add timestamp to each frame\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    ax = plt.gca()\n    plt.title(\n        f\"\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.savefig(\n        f\"rain_rate_{idx:02d}.png\",\n        dpi=150,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()","key":"aRvkB65j5A"},{"type":"outputs","id":"TPdt12fzblNLYhU2FcXn7","children":[],"key":"p1LD4qBkP8"}],"identifier":"58053a3f-6ba8-4717-bbe3-317db3df92ff","html_id":"58053a3f-6ba8-4717-bbe3-317db3df92ff","key":"ISADQQLCsU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS map colors\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\ntimes = [6, 8, 15]\n\nfor idx in times:\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5, 5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    ax = plt.gca()\n    ax.set_title(\n        f\"Rain Rate\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.show()","key":"dGga3TdjZq"},{"type":"outputs","id":"GGYZmtZwYZz0zs9YSP3f-","children":[],"key":"Z6krKtvAd0"}],"identifier":"e8275ed0-3f33-4513-b24f-40b044d35e13","html_id":"e8275ed0-3f33-4513-b24f-40b044d35e13","key":"XhQTzIb8Pm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Making all 24 time steps into a GIF","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"smoudc5GDM"}],"identifier":"making-all-24-time-steps-into-a-gif","label":"Making all 24 time steps into a GIF","html_id":"making-all-24-time-steps-into-a-gif","implicit":true,"key":"qC9uzV1E4X"}],"identifier":"b4dfd8a3-694c-4cf1-b6f3-d21293833af5","html_id":"b4dfd8a3-694c-4cf1-b6f3-d21293833af5","key":"QhWhr6grgk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NWS map colors\ncmap, norm = escmap(\"nwps_qpe\", units=\"mm\")\n\n# Save each hourly rain-rate map as an image\n\nfor idx in range(len(dta.time)):\n\n    mpasd.show(\n        dta,\n        var_name=\"rain_rate\",\n        time_index=idx,\n        figsize=(5, 5),\n        cmap=cmap,\n        norm=norm,\n    )\n\n    # Add timestamp to each frame\n    timestamp = pd.to_datetime(dta.time.values[idx])\n    timestr = timestamp.strftime(\"%d %b %Y, %H:%M UTC\")\n\n    plt.title(\n        f\"\\n{timestr}\",\n        pad=40,\n        x=0.61\n    )\n\n    plt.savefig(\n        f\"rain_rate_{idx:02d}.png\",\n        dpi=150,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()","key":"Tmb7cvdKLD"},{"type":"outputs","id":"nDqMjCwgjV1-1yG5pted5","children":[],"key":"VnYjIY3vZY"}],"identifier":"1818ab37-fda2-432d-a405-2789ad28aee2","html_id":"1818ab37-fda2-432d-a405-2789ad28aee2","key":"WLHoQVRzI0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Making the GIF\nfrom PIL import Image\n\nfiles = [f\"rain_rate_{i:02d}.png\" for i in range(len(dta.time))]\n\nframes = [Image.open(f).convert(\"RGB\") for f in files]\n\nframes[0].save(\n    \"ida_rainfall_evolution_24hr.gif\",\n    save_all=True,\n    append_images=frames[1:],\n    duration=500,\n    loop=0\n)","key":"UbyiTQQYIp"},{"type":"outputs","id":"0XthVnNPeUCzEd1-_RlJR","children":[],"key":"vmu0mOZ0qH"}],"identifier":"d50ae765-2bd4-432b-9471-8f376af58244","html_id":"d50ae765-2bd4-432b-9471-8f376af58244","key":"n9xuyoUsVn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# displaying the GIF\nfrom IPython.display import Image as IPImage\nIPImage(filename=\"ida_rainfall_evolution_24hr.gif\")","key":"PMULZBYEJY"},{"type":"outputs","id":"Rh9c3i0MBrN6E7SyF8btH","children":[],"key":"ziUFsm4PVZ"}],"identifier":"6d560170-17fe-4ec1-b51d-2299d4c19ad0","html_id":"6d560170-17fe-4ec1-b51d-2299d4c19ad0","key":"LzgLa8OSos"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Figure: Animation of MPAS-A simulated rain rate during the remnants of Hurricane Ida from 13 UTC 1 September to 12 UTC 2 September 2021. The animation highlights the evolution and movement of heavy precipitation bands across the northeastern United States, with peak rainfall occurring during the evening hours of 1 September.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dmtqXEYy2D"}],"key":"ljKbMnRXQX"}],"identifier":"f5ffdb10-8deb-435c-b093-50eea3403cda","html_id":"f5ffdb10-8deb-435c-b093-50eea3403cda","key":"Xkr8wCjjL5"}],"key":"jZ8yPdZJ9H"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Data to use","url":"/notebooks/readme","group":"Examples"},"next":{"title":"Exploring High-Impact Rainfall from Hurricane Ida’s Remnants with MPAS-Viewer (Part 2)","url":"/notebooks/hurricane-ida-pt2","group":"Examples"}}},"domain":"http://localhost:3000"}